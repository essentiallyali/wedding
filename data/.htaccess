# This folder holds the upload records and cached thumbnails. Nothing in here
# should ever be fetched directly over HTTP.
#
# Written for both Apache versions on purpose: an unrecognised directive
# causes a 500 on the whole folder, so each form is guarded by IfModule.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
